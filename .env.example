# Server-side ONLY — never use VITE_ prefixes for SMTP secrets.
# Turn on Google 2-Step Verification, then generate an App Password in your Google Account.
SMTP_USER=juarametacorp@gmail.com
SMTP_APP_PASSWORD=

# Site port: npm run dev and npm start both serve the frontend and API here.
PORT=3000

# Optional. Set when deployed behind a trusted reverse proxy; do not blindly enable.
TRUST_PROXY_HOPS=0
# Optional origin restriction in production (exact scheme + host, no trailing slash)
# PUBLIC_ORIGIN=https://your-official-domain.com

# CMS: run npm run cms:setup to generate this value securely.
CMS_ADMIN_PASSWORD_HASH=
# Optional persistent writable storage directory for production hosting
# CMS_DATA_DIR=/var/lib/juarametacorp
